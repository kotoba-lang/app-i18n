{:aiueos/component :app/i18n-tier
 :aiueos/kind :app
 :aiueos/trust :untrusted
 :aiueos/source "i18n_tier.cljk"
 :aiueos/wasm "i18n_tier.wasm"
 :aiueos/entry "main"
 :aiueos/args []
 :aiueos/imports #{}
 :aiueos/exports #{:app/main
                   :app/auto-xlate
                   :app/registry-judgment
                   :app/coverage-tier
                   :app/tier-consistent}
 :aiueos/effects #{}
 :aiueos/limits {:memory-pages 16 :fuel 5000000}}
